{
  "mailer_notifications_password_changed_enabled": true,
  "mailer_subjects_password_changed_notification": "Se cambió la contraseña de tu cuenta · Dotia",
  "mailer_templates_password_changed_notification_content": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" style=\"padding:8px 12px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:520px\"><tr><td style=\"font-family:Arial,Helvetica,sans-serif;color:#1B211D;text-align:left\">\n  <div style=\"background:#0A5B45;color:#ffffff;padding:20px 24px;border-radius:10px\">\n    <div style=\"font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.5)\">Dotia</div>\n    <div style=\"font-size:20px;font-weight:700;margin-top:10px\">Se cambió tu contraseña</div>\n  </div>\n  <p style=\"margin:20px 2px\">La contraseña de tu cuenta se cambió recién.</p>\n  <div style=\"margin:18px 2px;border:1px solid #E2E0D6;border-left:3px solid #B5480F;border-radius:8px;padding:14px 18px;background:#FDF4EF\">\n    <p style=\"margin:0;font-size:13px\"><strong>Si no fuiste tú</strong>, recupera tu contraseña de inmediato y escríbenos a <a href=\"mailto:contacto@dotia.cl\" style=\"color:#0B7E60\">contacto@dotia.cl</a>.</p>\n  </div>\n  <p style=\"margin:14px 2px;font-size:13px;color:#6B7269\">Si fuiste tú, no tienes que hacer nada.</p>\n  <p style=\"margin:24px 2px 2px;font-size:11px;color:#6B7269;border-top:1px solid #E2E0D6;padding-top:12px\">Dotia &middot; Trazabilidad de personal en faena</p>\n</td></tr></table></td></tr></table>",
