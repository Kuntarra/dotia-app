{
  "mailer_subjects_recovery": "Recuperar tu contraseña · Dotia",
  "mailer_templates_recovery_content": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#FAF9F5\"><tr><td align=\"center\" style=\"padding:32px 12px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:520px\"><tr><td style=\"background:#ffffff;border:1px solid #E2E0D6;border-radius:12px;padding:20px;font-family:Arial,Helvetica,sans-serif;color:#1B211D;text-align:left\">\n  <div style=\"background:#0A5B45;color:#ffffff;padding:20px 24px;border-radius:10px\">\n    <div style=\"font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.5)\">Dotia</div>\n    <div style=\"font-size:20px;font-weight:700;margin-top:10px\">Recuperar tu contraseña</div>\n  </div>\n  <p style=\"margin:20px 2px\">Hola,</p>\n  <p style=\"margin:12px 2px\">Recibimos una solicitud para restablecer la contraseña de tu cuenta.</p>\n  <p style=\"margin:22px 2px\"><a href=\"{{ .ConfirmationURL }}\" style=\"background:#0B7E60;color:#ffffff;text-decoration:none;padding:11px 22px;border-radius:8px;font-weight:600;display:inline-block\">Crear una contraseña nueva</a></p>\n  <p style=\"margin:14px 2px;font-size:13px;color:#6B7269\">Si no pediste este cambio, puedes ignorar este correo: tu contraseña no se modifica.</p>\n  <p style=\"margin:24px 2px 2px;font-size:11px;color:#6B7269;border-top:1px solid #E2E0D6;padding-top:12px\">Dotia &middot; Trazabilidad de personal en faena</p>\n</td></tr></table></td></tr></table>",
  "mailer_subjects_invite": "Te invitaron a Dotia",
  "mailer_templates_invite_content": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#FAF9F5\"><tr><td align=\"center\" style=\"padding:32px 12px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:520px\"><tr><td style=\"background:#ffffff;border:1px solid #E2E0D6;border-radius:12px;padding:20px;font-family:Arial,Helvetica,sans-serif;color:#1B211D;text-align:left\">\n  <div style=\"background:#0A5B45;color:#ffffff;padding:20px 24px;border-radius:10px\">\n    <div style=\"font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.5)\">Dotia</div>\n    <div style=\"font-size:20px;font-weight:700;margin-top:10px\">Te invitaron a Dotia</div>\n  </div>\n  <p style=\"margin:20px 2px\">Hola,</p>\n  <p style=\"margin:12px 2px\">Te crearon una cuenta para seguir la trazabilidad del personal en faena. Entra y define tu contraseña para empezar.</p>\n  <p style=\"margin:22px 2px\"><a href=\"{{ .ConfirmationURL }}\" style=\"background:#0B7E60;color:#ffffff;text-decoration:none;padding:11px 22px;border-radius:8px;font-weight:600;display:inline-block\">Aceptar la invitación</a></p>\n  <p style=\"margin:14px 2px;font-size:13px;color:#6B7269\">Si no esperabas esta invitación, puedes ignorar este correo.</p>\n  <p style=\"margin:24px 2px 2px;font-size:11px;color:#6B7269;border-top:1px solid #E2E0D6;padding-top:12px\">Dotia &middot; Trazabilidad de personal en faena</p>\n</td></tr></table></td></tr></table>",
  "mailer_subjects_magic_link": "Tu enlace de acceso a Dotia",
  "mailer_templates_magic_link_content": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#FAF9F5\"><tr><td align=\"center\" style=\"padding:32px 12px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:520px\"><tr><td style=\"background:#ffffff;border:1px solid #E2E0D6;border-radius:12px;padding:20px;font-family:Arial,Helvetica,sans-serif;color:#1B211D;text-align:left\">\n  <div style=\"background:#0A5B45;color:#ffffff;padding:20px 24px;border-radius:10px\">\n    <div style=\"font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.5)\">Dotia</div>\n    <div style=\"font-size:20px;font-weight:700;margin-top:10px\">Tu enlace de acceso</div>\n  </div>\n  <p style=\"margin:20px 2px\">Hola,</p>\n  <p style=\"margin:12px 2px\">Usa este enlace para entrar a tu cuenta. Sirve una sola vez y caduca en poco rato.</p>\n  <p style=\"margin:22px 2px\"><a href=\"{{ .ConfirmationURL }}\" style=\"background:#0B7E60;color:#ffffff;text-decoration:none;padding:11px 22px;border-radius:8px;font-weight:600;display:inline-block\">Entrar a Dotia</a></p>\n  <p style=\"margin:14px 2px;font-size:13px;color:#6B7269\">Si no pediste este enlace, puedes ignorar este correo.</p>\n  <p style=\"margin:24px 2px 2px;font-size:11px;color:#6B7269;border-top:1px solid #E2E0D6;padding-top:12px\">Dotia &middot; Trazabilidad de personal en faena</p>\n</td></tr></table></td></tr></table>",
  "mailer_subjects_confirmation": "Confirma tu correo · Dotia",
  "mailer_templates_confirmation_content": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#FAF9F5\"><tr><td align=\"center\" style=\"padding:32px 12px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:520px\"><tr><td style=\"background:#ffffff;border:1px solid #E2E0D6;border-radius:12px;padding:20px;font-family:Arial,Helvetica,sans-serif;color:#1B211D;text-align:left\">\n  <div style=\"background:#0A5B45;color:#ffffff;padding:20px 24px;border-radius:10px\">\n    <div style=\"font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.5)\">Dotia</div>\n    <div style=\"font-size:20px;font-weight:700;margin-top:10px\">Confirma tu correo</div>\n  </div>\n  <p style=\"margin:20px 2px\">Hola,</p>\n  <p style=\"margin:12px 2px\">Falta un paso para terminar de crear tu cuenta: confirmar que este correo es tuyo.</p>\n  <p style=\"margin:22px 2px\"><a href=\"{{ .ConfirmationURL }}\" style=\"background:#0B7E60;color:#ffffff;text-decoration:none;padding:11px 22px;border-radius:8px;font-weight:600;display:inline-block\">Confirmar mi correo</a></p>\n  <p style=\"margin:14px 2px;font-size:13px;color:#6B7269\">Si no creaste ninguna cuenta, puedes ignorar este correo.</p>\n  <p style=\"margin:24px 2px 2px;font-size:11px;color:#6B7269;border-top:1px solid #E2E0D6;padding-top:12px\">Dotia &middot; Trazabilidad de personal en faena</p>\n</td></tr></table></td></tr></table>",
  "mailer_subjects_email_change": "Confirma tu correo nuevo · Dotia",
  "mailer_templates_email_change_content": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#FAF9F5\"><tr><td align=\"center\" style=\"padding:32px 12px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:520px\"><tr><td style=\"background:#ffffff;border:1px solid #E2E0D6;border-radius:12px;padding:20px;font-family:Arial,Helvetica,sans-serif;color:#1B211D;text-align:left\">\n  <div style=\"background:#0A5B45;color:#ffffff;padding:20px 24px;border-radius:10px\">\n    <div style=\"font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.5)\">Dotia</div>\n    <div style=\"font-size:20px;font-weight:700;margin-top:10px\">Confirma tu correo nuevo</div>\n  </div>\n  <p style=\"margin:20px 2px\">Hola,</p>\n  <p style=\"margin:12px 2px\">Pediste cambiar el correo de tu cuenta a <strong>{{ .NewEmail }}</strong>. Confírmalo para que quede activo.</p>\n  <p style=\"margin:22px 2px\"><a href=\"{{ .ConfirmationURL }}\" style=\"background:#0B7E60;color:#ffffff;text-decoration:none;padding:11px 22px;border-radius:8px;font-weight:600;display:inline-block\">Confirmar el correo nuevo</a></p>\n  <p style=\"margin:14px 2px;font-size:13px;color:#6B7269\">Si no pediste este cambio, ignora este correo: tu correo actual sigue siendo el válido.</p>\n  <p style=\"margin:24px 2px 2px;font-size:11px;color:#6B7269;border-top:1px solid #E2E0D6;padding-top:12px\">Dotia &middot; Trazabilidad de personal en faena</p>\n</td></tr></table></td></tr></table>",
  "mailer_subjects_reauthentication": "{{ .Token }} es tu código de verificación",
  "mailer_templates_reauthentication_content": "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#FAF9F5\"><tr><td align=\"center\" style=\"padding:32px 12px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:520px\"><tr><td style=\"background:#ffffff;border:1px solid #E2E0D6;border-radius:12px;padding:20px;font-family:Arial,Helvetica,sans-serif;color:#1B211D;text-align:left\">\n  <div style=\"background:#0A5B45;color:#ffffff;padding:20px 24px;border-radius:10px\">\n    <div style=\"font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.5)\">Dotia</div>\n    <div style=\"font-size:20px;font-weight:700;margin-top:10px\">Tu código de verificación</div>\n  </div>\n  <p style=\"margin:20px 2px\">Hola,</p>\n  <p style=\"margin:12px 2px\">Para confirmar que eres tú, escribe este código en la aplicación:</p>\n  <p style=\"margin:22px 2px;font-size:30px;font-weight:700;letter-spacing:.28em;color:#0A5B45\">{{ .Token }}</p>\n  <p style=\"margin:14px 2px;font-size:13px;color:#6B7269\">Caduca en unos minutos. Si no lo pediste, ignora este correo.</p>\n  <p style=\"margin:24px 2px 2px;font-size:11px;color:#6B7269;border-top:1px solid #E2E0D6;padding-top:12px\">Dotia &middot; Trazabilidad de personal en faena</p>\n</td></tr></table></td></tr></table>"
}