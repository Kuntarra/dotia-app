# Públicas (cliente) — se exponen al navegador
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# SECRETA — solo servidor. NO usar prefijo NEXT_PUBLIC. Necesaria para el panel admin
# (lib/supabase/admin.ts). En Vercel: agregar como variable de entorno del proyecto.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Correos (Resend) — necesario para enviar informes diarios/mensuales
# RESEND_API_KEY: obtener en resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# DIGEST_FROM: debe ser un dominio verificado en Resend (ej: no-reply@dotia.cl)
# Si no se configura, usa onboarding@resend.dev (solo funciona con el correo de tu cuenta Resend)
DIGEST_FROM=Dotia <no-reply@dotia.cl>

# CRON_SECRET: cadena secreta para proteger el endpoint del cron. Debe coincidir
# con la que Vercel envía en el header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=una-cadena-larga-y-secreta
